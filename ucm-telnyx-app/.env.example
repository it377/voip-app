# ---- App / auth ----
PORT=3000
# Random long string used to sign session cookies. Generate with:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=change-me-too

# On first run (empty data/accounts.json) one admin account is created from
# these. After that, manage users in the app's Admin tab - these are ignored.
# Leave ADMIN_PASSWORD blank and a random one is generated and printed once to
# the server console.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# ---- Telnyx ----
# API key from https://portal.telnyx.com/#/app/api-keys
TELNYX_API_KEY=KEY_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# The Telnyx long-code / toll-free number you send/receive SMS on, E.164 format
TELNYX_FROM_NUMBER=+15555550123
# Messaging profile ID the number above is assigned to (portal.telnyx.com/#/app/messaging)
TELNYX_MESSAGING_PROFILE_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# Public key shown on the same messaging profile page, used to verify inbound
# webhook signatures (ed25519). Strongly recommended - leave blank only for
# quick local testing.
TELNYX_PUBLIC_KEY=

# ---- SIP / UCM6301 ----
# Nothing to set here. PBX settings (domain, WSS URL, SIP port/transport) and
# each user's extension + SIP secret are managed in the app's Admin tab and
# stored in data/accounts.json, so clients get them at login automatically.
