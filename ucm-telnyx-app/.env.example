# ---- App / auth ----
PORT=3000
# Shared password gating the whole app (login screen). Change this.
APP_PASSWORD=change-me
# Random long string used to sign session cookies. Generate with:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=change-me-too

# ---- Telnyx ----
# API key from https://portal.telnyx.com/#/app/api-keys
TELNYX_API_KEY=KEY_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# The Telnyx long-code / toll-free number you send/receive SMS on, E.164 format
TELNYX_FROM_NUMBER=+15555550123
# Messaging profile ID the number above is assigned to (portal.telnyx.com/#/app/messaging)
TELNYX_MESSAGING_PROFILE_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# Public key shown on the same messaging profile page, used to verify inbound
# webhook signatures (ed25519). Strongly recommended - leave blank only for
# quick local testing.
TELNYX_PUBLIC_KEY=

# ---- SIP / UCM6301 (defaults only - can also be entered/changed in the browser UI) ----
# These are NOT secret to your server; they're handed to the browser so it can
# register directly with your PBX over WSS. Leave blank to configure per-browser
# in Settings instead.
SIP_WSS_URL=wss://your-ucm-hostname-or-ip:8089/ws
SIP_DOMAIN=your-ucm-hostname-or-ip
SIP_EXTENSION=
SIP_PASSWORD=
